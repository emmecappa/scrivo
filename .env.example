# Firebase Configuration
# Copia questo file in .env e inserisci i tuoi valori
# Li trovi in Firebase Console → Project Settings → General → Your apps → Web app

# API Key (dalla configurazione firebaseConfig)
VITE_FIREBASE_API_KEY=AIzaSy...

# Auth Domain (dalla configurazione firebaseConfig)
VITE_FIREBASE_AUTH_DOMAIN=tuo-progetto.firebaseapp.com

# Project ID (dalla configurazione firebaseConfig)
VITE_FIREBASE_PROJECT_ID=tuo-progetto

# Storage Bucket (dalla configurazione firebaseConfig)
VITE_FIREBASE_STORAGE_BUCKET=tuo-progetto.appspot.com

# Messaging Sender ID (dalla configurazione firebaseConfig)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# App ID (dalla configurazione firebaseConfig)
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
